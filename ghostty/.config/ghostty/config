theme="luna"
# splits
unfocused-split-opacity = 0.85
keybind = alt+shift+]=goto_split:next
keybind = alt+shift+[=goto_split:previous
keybind = alt+shift+p=new_split:right
keybind = alt+shift+o=new_split:down
keybind = alt+shift+w=close_surface

# window properties
window-theme = ghostty
window-inherit-working-directory = true
window-padding-x = 16	
window-padding-y = 8
# macos-titlebar-proxy-icon = hidden

# shell
mouse-hide-while-typing = true
# Berkeley Mono ships as family "TX-02-Variable"
font-family = "TX-02-Variable"

# named instances (weights)
# 400 Regular
# 425 Book
# 500 Medium
# 600 SemiBold
# 700 Bold
# italics are "<weight> Oblique"
font-style = Medium
font-style-bold = Bold
font-style-italic = Medium Oblique
font-style-bold-italic = Bold Oblique
font-size = 16

# bright works because of thicken
font-thicken = true
bold-color = bright 

# ligatures
font-feature = -calt 
font-feature = -liga

# contrast

minimum-contrast = 1.1


# Cell
adjust-cell-height= 20%
adjust-cell-width= -4%

# quick term
keybind = global:cmd+backquote=toggle_quick_terminal

# machine-local overrides (gitignored; loaded last, so its values win)
config-file = ?config.local
